<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CSR</RootNamespace>
    <AssemblyName>csr</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>csr</ToolCommandName>
    <PackageId>CSRefactor</PackageId>
    <Description>Анализ и рефакторинг C# для ИИ-агентов</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSR.Reports\CSR.Reports.csproj" />
    <ProjectReference Include="..\CSR.Workspace\CSR.Workspace.csproj" />
  </ItemGroup>

  <!-- BuildHost Roslyn запускается отдельным процессом из папок BuildHost-* рядом с csr.exe:
       в однофайловую сборку (PublishSingleFile) его файлы не упаковываются -->
  <Target Name="ExcludeBuildHostFromSingleFile" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('BuildHost-'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
