// Пример конфига csr style: csr style <папка> --config style.jsonc --project project.jsonc
// Проверка, которой нет в конфиге, выключена. У проверки: "severity" (error | warning | hint), "rule" - метка правила
// вашего гайда (попадает в находку), "enabled": false - выключить в следующем слое, остальное - параметры.
// Список проверок и параметров - DOCS.md
{
  "checks": {
    "line-length": { "severity": "error", "rule": "STYLE-1", "max": 120 },
    "directive-column": { "severity": "warning" },
    "binary-op-wrap": { "severity": "warning", "prefer": "leading", "operators": ["&&", "||"] },
    "xml-doc": { "severity": "hint", "explanation": "comment", "max": 120 },
    "comment-separator": { "severity": "warning" },
    "comment-typography": { "severity": "warning", "attributes": ["Tooltip"] },
    "comment-ending": { "severity": "hint", "prefer": "no-period" },
    "commented-code": { "severity": "hint" },
    "todo-format": { "severity": "hint", "forbidMetadata": true },
    "log-call-wrap": { "severity": "warning", "maxLength": 120 },
    "message-text": { "severity": "warning", "concatenation": true, "trailingPeriod": true },
    "null-check": { "severity": "warning", "prefer": "equality" },
    "coalesce-assignment": { "severity": "hint" },
    "out-var": { "severity": "warning", "prefer": "explicit", "discardUnused": true },
    "bool-local-type": { "severity": "warning", "prefer": "explicit" },
    "local-type": { "severity": "hint", "prefer": "var", "foreach": true, "foreachExplicitTypes": [] },
    "tuple-type": { "severity": "warning" },
    "explicit-private": { "severity": "warning", "prefer": "explicit", "members": ["field", "method"] },
    "forbidden-modifier": { "severity": "warning", "modifiers": ["sealed"] },
    "custom-delegate": { "severity": "hint" },
    "expression-arrow": { "severity": "warning", "properties": "next-line", "methods": "fit", "max": 120 },
    "signature-wrap": { "severity": "warning", "max": 120, "minParameters": 5, "initializerOnOwnLine": true },
    "call-wrap": { "severity": "warning", "max": 120 },
    "region-layout": { "severity": "hint", "inside": 1, "between": 2, "outside": 1 },
    "condition-wrap": { "severity": "warning", "max": 120, "argumentIndent": true, "continuationIndent": true, "assignmentIndent": false },
    "initializer-layout": { "severity": "warning", "max": 120, "trailingComma": true },
    "ternary-wrap": { "severity": "warning", "max": 120, "nested": true },
    // Именование: правила по порядку; для каждого вида требования действует первое подходящее правило
    "naming": {
      "severity": "warning",
      "rules": [
        { "symbols": { "kinds": ["field"], "modifiers": ["const"] }, "case": "pascal", "prefix": "*" },
        { "symbols": { "kinds": ["field"], "access": ["protected", "internal", "public"] }, "prefix": "" },
        { "symbols": { "kinds": ["field"], "modifiers": ["static", "readonly"] }, "prefix": "" },
        { "symbols": { "kinds": ["field"], "modifiers": ["static"] }, "prefix": "s_", "pascalAfterPrefix": true },
        { "symbols": { "kinds": ["field"] }, "prefix": "m_", "pascalAfterPrefix": true },
        { "symbols": { "kinds": ["property"] }, "prefix": "" },
        { "symbols": { "types": ["bool", "Boolean"] }, "forbiddenWords": ["Not", "No", "Non", "Dont"], "negation": true, "label": "bool" },
        { "symbols": { "kinds": ["event"] }, "allowed": ["On*"], "forbidden": ["OnWill*", "OnDid*"] },
        { "symbols": { "kinds": ["delegate"] }, "forbiddenPrefixes": ["On"] },
        { "symbols": { "kinds": ["interface"] }, "prefix": "I", "prefixStyle": "word" },
        { "symbols": { "kinds": ["typeParameter"] }, "prefix": "T", "prefixStyle": "word", "prefixAlone": true },
        { "symbols": { "kinds": ["class"], "bases": ["CommandBase"] }, "allowed": ["*Command"] },
        { "symbols": { "kinds": ["namespace"] }, "roots": ["Company"], "forbiddenWords": ["Editor"], "maxParts": 4 },
        { "symbols": { "kinds": ["class", "struct", "record", "interface", "enum"] }, "roots": ["Company"], "label": "тип" },
        { "symbols": { "kinds": ["enum"], "attributes": ["Flags"] }, "number": "plural", "pluralWords": ["Mask"], "severity": "hint" },
        { "symbols": { "kinds": ["enum"] }, "number": "singular", "pluralWords": ["Mask"], "severity": "hint" },
        { "symbols": { "kinds": ["field", "property"], "types": ["List<*>", "HashSet<*>", "Dictionary<*>", "*[*]"] }, "number": "plural", "pluralWords": ["List", "Set", "Map", "Data"], "label": "коллекция", "severity": "hint" }
      ]
    },
    // Запреты команды: что запрещено и чем заменить; excludePaths - где проверка не работает
    "forbidden-call": {
      "severity": "error",
      "calls": { "Debug.Log*": "логгер проекта", "Gizmos.*": "механизм отладочной отрисовки" },
      "excludePaths": ["*/Editor/*"]
    },
    "forbidden-type": { "severity": "error", "types": { "dynamic": "строгая типизация" } },
    "coroutine": { "severity": "error", "use": "асинхронный метод или Update" },
    "static-state": { "severity": "error", "use": "сервис проекта", "ignoreAttributes": ["ThreadStatic"] },
    "local-function": { "severity": "error", "use": "private-метод", "excludePaths": ["*/Editor/*", "*/Tests/*"] },
    "path-concat": { "severity": "warning" },
    "bool-field-count": { "severity": "warning", "baseTypes": ["MonoBehaviour"], "minFields": 3 },
    "type-per-file": { "severity": "warning", "baseTypes": ["MonoBehaviour", "ScriptableObject"] },
    "closure-in-method": { "severity": "hint", "methods": ["Update", "LateUpdate", "FixedUpdate"] },
    "nested-loop": { "severity": "hint" }
  }
}
